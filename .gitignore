# ---- Data -----------------------------------------------------------------
# Approved public source CSVs in data/raw/ and the submitted workbook in
# data/processed/ are intentionally versioned for this project. Ignore only
# additional large or binary data formats unless a maintainer explicitly
# reviews and versions them.
*.csv.gz
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.sqlite
*.db
*.arrow

# ---- Model artifacts ------------------------------------------------------
models/*.pt
models/*.h5
models/*.pkl
models/*.bin
models/*.onnx
models/*.joblib

# ---- Logs and temp --------------------------------------------------------
*.log
logs/
tmp/
*.tmp

# ---- Secrets and credentials ---------------------------------------------
# Never commit credentials. If you accidentally do, rotate the secret first.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# ---- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
